# Opcional. Si tienes dominio propio, pon aquí la URL canónica de producción.
# En Vercel se detecta automáticamente el dominio principal si esta variable se deja vacía.
NEXT_PUBLIC_SITE_URL=

# Tag de Amazon Associates de esta web.
NEXT_PUBLIC_AMAZON_TAG=gamergadget08-20
# Opcional: adapta el marketplace a las condiciones de tu cuenta de afiliado.
NEXT_PUBLIC_AMAZON_BASE_URL=https://www.amazon.com

# Opcional: el importador de enlaces redacta borradores originales con la API.
# Guarda la clave sólo en .env.local; nunca la subas al repositorio ni a variables NEXT_PUBLIC.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1
